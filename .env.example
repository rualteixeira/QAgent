# Copiar para .env. Todas as chaves têm valores por omissão em src/qagent/config.py.
# QAGENT_RUNS_DIR=C:\Users\...\QAgent\runs
# QAGENT_CAPABILITIES_CONFIG=C:\Users\...\QAgent\config\capabilities.json
# QAGENT_APPIUM_MCP_VERSION=1.99.3

# http = servidor appium-mcp de longa duração (scripts/start-appium-mcp.ps1); stdio = 1 processo por execução (~33 s de arranque)
# QAGENT_MCP_TRANSPORT=http
# QAGENT_MCP_HTTP_URL=http://127.0.0.1:8080/sse

# Só para transport=stdio
# QAGENT_ANDROID_HOME=C:\Android\Sdk
# QAGENT_JAVA_HOME=C:\Android\JDK
